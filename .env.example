# Lexta Gh Supabase project (euqirakpychkhpwoszos). Publishable values only; never commit secret keys.
NEXT_PUBLIC_SUPABASE_URL=https://euqirakpychkhpwoszos.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Lexta Business System (portal) address, used for the "Staff login" link on the Lexta site.
NEXT_PUBLIC_PORTAL_URL=https://lexta-portal.vercel.app

# Public address of the Lexta site (canonical links, share and Open Graph URLs). Example value only.
# Leave unset on previews: Vercel's own project address is used, or relative links locally.
# Desmond alone sets the real domain at go-live.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# "Edit once, sites update". Example values only; set real ones in each Vercel project.
# Shared secret: the same value on every website (lexta-web and later the brand sites) and on the portal.
REVALIDATE_SECRET=replace-with-a-long-random-string
# Portal only: comma separated revalidate routes of every website that shows products.
SITE_REVALIDATE_URLS=https://lexta-web-preview.vercel.app/api/revalidate

# Lexta site only, server side (never NEXT_PUBLIC): signs Careers CV upload requests. Generate once with
# `openssl rand -hex 32`, put the same value in the Supabase table private.recruitment_intake_secret (see
# supabase/migrations/0008_recruitment.sql). Example value only; never commit the real one.
RECRUITMENT_INTAKE_SECRET=replace-with-64-random-hex-characters

# Lexta site only, server side (never NEXT_PUBLIC): signs every live chat call (start, send, read). Generate once
# with `openssl rand -hex 32`, put the same value in the Supabase table private.chat_intake_secret (see
# supabase/migrations/0009_live_chat.sql). Until both are set the chat says it is not available. Example value only.
CHAT_INTAKE_SECRET=replace-with-64-random-hex-characters

# Portal only, server side (never NEXT_PUBLIC): signs each field sales photo the portal has checked, so the database
# records only those. Generate once with `openssl rand -hex 32`, put the same value in the Supabase table
# private.field_photo_secret (see supabase/migrations/0011_field_sales.sql). Until both are set, visits save but photos
# are refused. Example value only; never commit the real one.
FIELD_PHOTO_SECRET=replace-with-64-random-hex-characters
